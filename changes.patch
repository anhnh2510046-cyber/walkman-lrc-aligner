new file mode 100644
index 0000000..ec3786e
--- /dev/null
+++ b/aligner.py
@@ -0,0 +1,41 @@
+"""Forced alignment and exclusive, non-destructive sidecar writing."""
+import math
+from pathlib import Path
+
+
+def write_new(path, text):
+    with Path(path).open('x', encoding='utf-8', newline='\n') as handle:
+        handle.write(text)
+
+
+def timestamp(seconds):
+    if not math.isfinite(seconds) or seconds < 0:
+        raise ValueError('Invalid alignment timestamp')
+    centiseconds = int(seconds * 100 + 0.5)
+    minutes, remainder = divmod(centiseconds, 6000)
+    seconds, fraction = divmod(remainder, 100)
+    return f'[{minutes:02d}:{seconds:02d}.{fraction:02d}]'
+
+
+class Aligner:
+    def __init__(self, model='small', device='cpu'):
+        import stable_whisper
+        self.model = stable_whisper.load_model(model, device=device)
+
+    def align(self, path, lyrics, language='en'):
+        lines = [line for line in lyrics.splitlines() if line.strip()]
+        result = self.model.align(str(path), '\n'.join(lines), language=language,
+                                  original_split=True)
+        if result is None or len(result.segments) != len(lines):
+            raise ValueError('Alignment did not preserve canonical line count; no LRC written')
+        entries = []
+        previous = -1.0
+        for line, segment in zip(lines, result.segments):
+            start = float(segment.start)
+            if start < previous:
+                raise ValueError('Alignment timestamps are not ordered')
+            entries.append(f'{timestamp(start)} {line}')
+            previous = start
+        if not entries:
+            raise ValueError('No lyrics aligned')
+        return '\n'.join(entries) + '\n'
diff --git a/comparator.py b/comparator.py
new file mode 100644
index 0000000..bd16e4c
--- /dev/null
+++ b/comparator.py
@@ -0,0 +1,57 @@
+"""Local transcription and canonical-line comparison."""
+from dataclasses import dataclass
+import re
+import unicodedata
+
+
+def normalize(text):
+    text = unicodedata.normalize('NFKC', text).casefold()
+    text = re.sub(r'\bstr8\b', 'straight', text)
+    return ' '.join(re.findall(r'\w+', text))
+
+
+@dataclass(frozen=True)
+class Comparison:
+    canonical: str
+    heard: str
+    score: float
+
+
+class Transcriber:
+    def __init__(self, model='small', device='cpu', compute_type='int8'):
+        from faster_whisper import WhisperModel
+        self.model = WhisperModel(model, device=device, compute_type=compute_type)
+
+    def transcribe(self, path, language=None):
+        segments, _ = self.model.transcribe(str(path), language=language, vad_filter=True)
+        return [s.text.strip() for s in segments if s.text.strip()]
+
+
+def compare_lines(lyrics, transcript):
+    """Find ordered segment windows; never silently rewrite canonical lyrics."""
+    from rapidfuzz.fuzz import ratio
+    rows = []
+    cursor = 0
+    for line in lyrics.splitlines():
+        if not line.strip():
+            continue
+        candidates = []
+        for start in range(cursor, len(transcript)):
+            for end in range(start + 1, min(start + 4, len(transcript)) + 1):
+                heard = ' '.join(transcript[start:end])
+                candidates.append((ratio(normalize(line), normalize(heard)), start, end, heard))
+        if candidates:
+            score, start, end, heard = max(candidates, key=lambda x: (x[0], -x[1], -x[2]))
+            # Reuse a segment when Whisper put several canonical lines in it.
+            cursor = start
+            rows.append(Comparison(line, heard, score))
+        else:
+            rows.append(Comparison(line, '', 0.0))
+    return rows
+
+
+def show_diff(rows, output=print):
+    output('Match | Canonical lyrics | Whisper transcript')
+    for row in rows:
+        output(f'{row.score:5.1f}% | {row.canonical} | {row.heard}')
+    output('Canonical spelling and line breaks are preserved; low scores need review.')
diff --git a/genius_fetcher.py b/genius_fetcher.py
new file mode 100644
index 0000000..5a96296
--- /dev/null
+++ b/genius_fetcher.py
@@ -0,0 +1,46 @@
+"""Interactive Genius resolution; transcription fallback always needs consent."""
+import re
+
+
+def clean_lyrics(text):
+    lines = text.splitlines()
+    if lines and re.search(r'(?:Contributors.*Lyrics| Lyrics)$', lines[0]):
+        lines.pop(0)
+    text = '\n'.join(lines)
+    text = re.sub(r'\d*Embed\s*$', '', text)
+    return '\n'.join(line.strip() for line in text.splitlines()
+                     if line.strip() and not re.fullmatch(r'\s*\[.*\]\s*', line))
+
+
+def resolve_lyrics(artist, title, token=None, ask=input, output=print):
+    client = None
+    if token:
+        import lyricsgenius
+        client = lyricsgenius.Genius(token, verbose=False, remove_section_headers=True,
+                                     retries=2, timeout=15)
+    else:
+        output('GENIUS_ACCESS_TOKEN is unset; Genius search is unavailable.')
+    while client is not None:
+        try:
+            song = client.search_song(title, artist)
+        except Exception as exc:
+            # Never print request details, which may contain the access token.
+            output(f'Genius search failed ({type(exc).__name__}).')
+            song = None
+        lyrics = clean_lyrics(song.lyrics) if song else ''
+        if lyrics:
+            output(f'Candidate: {song.artist} — {song.title}')
+            output('\n'.join(lyrics.splitlines()[:4]))
+            while True:
+                choice = ask('Use these lyrics? [Y]/[N]/[R]: ').strip().lower()
+                if choice in {'y', 'n', 'r'}:
+                    break
+            if choice == 'y':
+                return lyrics
+        replacement = ask('Alternative song title (blank to stop searching): ').strip()
+        if not replacement:
+            break
+        title = replacement
+    if ask('Generate lyrics entirely with local Whisper instead? [y/N]: ').strip().lower() == 'y':
+        return None
+    raise ValueError('Track skipped: no lyrics approved.')
diff --git a/main.py b/main.py
